{
  "openapi": "3.1.0",
  "info": {
    "title": "Cloudflare Worker HTML Transformer API",
    "version": "1.1.0",
    "description": "Fetch and transform HTML content from a target URL. Optional transformations include removing JavaScript, CSS, extracting text, and cleaning the HTML. Supports advanced caching mechanism with unified cache object including HTML, extracted formats (JSON, Text, Markdown), and LLM digested formats via Cloudflare KV store."
  },
  "servers": [
    {
      "url": "https://proxy.cf-io.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API_TOKEN",
        "description": "Provide the Bearer token (defaults to 'testtoken' if not set in environment) to access protected endpoints."
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "getTransformedHtml",
        "summary": "Fetch and transform HTML content",
        "description": "Fetches HTML content from the specified URL and returns it in the requested format (raw, cleaned, JSON, text, markdown, rss, or digested). Supports caching with configurable TTL.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "The target URL to fetch HTML content from.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Target format to return. If omitted, defaults based on legacy boolean flags (e.g. raw_html, cleaned_html, extracted).",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["raw_html", "cleaned_html", "json", "text", "markdown", "rss", "digested", "all", "extracted"]
            }
          },
          {
            "name": "removeJs",
            "in": "query",
            "description": "(Legacy) If present, removes <script> and <link> tags from the HTML. Equivalent to format=cleaned_html.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "removeCss",
            "in": "query",
            "description": "(Legacy) If present, removes <style> tags and inline style attributes from the HTML. Equivalent to format=cleaned_html.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "extractContent",
            "in": "query",
            "description": "(Legacy) If present, extracts content from the HTML (JSON > Markdown > Text). Equivalent to format=extracted.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "cleanHtml",
            "in": "query",
            "description": "(Legacy) If present, cleans the HTML. Equivalent to format=cleaned_html.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "noCache",
            "in": "query",
            "description": "If present, skips cache lookup and doesn't store the response in cache.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "forceRefresh",
            "in": "query",
            "description": "If present, skips cache lookup but still updates the cache with fresh content.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "useService",
            "in": "query",
            "description": "ID of a registered browser service to use for rendering the page instead of fetching directly.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cacheTtl",
            "in": "query",
            "description": "Cache time-to-live in seconds. Default is 3600 (1 hour).",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3600,
              "minimum": 60,
              "maximum": 2592000
            }
          },
          {
            "name": "cors",
            "in": "query",
            "description": "If present, enables CORS by returning the Access-Control-Allow-Origin header. Can be set to a specific origin (e.g. cors=https://my-app.com), empty, or 'true' to allow all origins (*).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transformed content.",
            "headers": {
              "X-Cache": {
                "schema": {
                  "type": "string",
                  "enum": ["HIT", "HIT-UPDATED", "MISS"]
                },
                "description": "Indicates whether the response was served entirely from cache (HIT), served from cache but updated a specific missing format (HIT-UPDATED), or freshly fetched (MISS)."
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "Accepted. The request was delegated to a registered asynchronous webhook service.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "serviceStatus": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Missing or invalid URL parameter.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not found. Extracted content is empty.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error while fetching or processing the URL.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/cache/update": {
      "post": {
        "operationId": "updateCache",
        "summary": "Update cached content for a URL",
        "description": "Updates specific fields (HTML, extracted formats, or digested LLM object) in the cache for a given URL without re-fetching from origin. Existing un-updated fields in the cache are preserved.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "The target URL whose cache entry needs to be updated."
                  },
                  "html": {
                    "type": "object",
                    "description": "HTML content forms.",
                    "properties": {
                      "raw_html": { "type": "string", "nullable": true },
                      "cleaned_html": { "type": "string", "nullable": true }
                    }
                  },
                  "extracted": {
                    "type": "object",
                    "description": "Extracted content forms.",
                    "properties": {
                      "json": { "type": "object", "nullable": true },
                      "text": { "type": "string", "nullable": true },
                      "markdown": { "type": "string", "nullable": true }
                    }
                  },
                  "digested": {
                    "type": "object",
                    "description": "Digested content by an LLM.",
                    "properties": {
                      "summary": { "type": "string", "description": "Summary in markdown format", "nullable": true },
                      "notes": { "type": "string", "nullable": true },
                      "images": { "type": "array", "items": { "type": "string" }, "nullable": true }
                    },
                    "additionalProperties": true
                  },
                  "contentType": {
                    "type": "string",
                    "description": "The original content type of the fetched URL."
                  },
                  "cacheTtl": {
                    "type": "integer",
                    "description": "Override Cache time-to-live in seconds for this specific update."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cache updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "cacheKey": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Missing 'url' parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Invalid or missing Bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error during cache update.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/services": {
      "get": {
        "operationId": "listServices",
        "summary": "List registered browser services",
        "description": "Returns a list of all dynamically registered browser services.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of registered services.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "services": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "type": { "type": "string", "enum": ["http", "webhook"] },
                          "url": { "type": "string" },
                          "method": { "type": "string" },
                          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                          "payloadTemplate": { "type": "object", "additionalProperties": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Invalid or missing Bearer token."
          }
        }
      },
      "post": {
        "operationId": "registerService",
        "summary": "Register a new browser service",
        "description": "Registers or updates a browser service (HTTP or webhook) that can be triggered when fetching URLs.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id", "url", "type"],
                "properties": {
                  "id": { "type": "string", "description": "Unique identifier for the service" },
                  "name": { "type": "string", "description": "Human readable name for the service" },
                  "type": { "type": "string", "enum": ["http", "webhook"], "description": "Type of service. 'http' returns HTML synchronously, 'webhook' triggers an async process." },
                  "url": { "type": "string", "format": "uri", "description": "The endpoint to call to trigger the service" },
                  "method": { "type": "string", "description": "HTTP method to use (e.g. POST, GET)" },
                  "headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Custom headers to send" },
                  "payloadTemplate": { 
                    "type": "object", 
                    "additionalProperties": true,
                    "description": "Template for the payload. Variables {{urls}}, {{url}}, {{apiEndpoint}}, and {{token}} will be resolved before sending. For backwards compatibility, {{url}} is still supported, but {{urls}} is recommended for batch processing."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Service registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "service": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Missing required fields."
          },
          "401": {
            "description": "Unauthorized. Invalid or missing Bearer token."
          }
        }
      },
      "delete": {
        "operationId": "deregisterService",
        "summary": "Deregister a browser service",
        "description": "Removes a previously registered browser service.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The unique ID of the service to remove.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Service deregistered successfully."
          },
          "400": {
            "description": "Bad request. Missing id parameter."
          },
          "401": {
            "description": "Unauthorized. Invalid or missing Bearer token."
          },
          "404": {
            "description": "Service not found."
          }
        }
      }
    }
  }
}
